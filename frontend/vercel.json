{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://resq-ai-red.vercel.app/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://resq-ai-red.vercel.app/api/$1"
    },
    {
      "source": "/((?!assets).*)",
      "destination": "/index.html"
    }
  ]
}
